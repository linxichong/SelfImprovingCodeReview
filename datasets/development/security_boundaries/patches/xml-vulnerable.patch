+from lxml import etree
+
+
+def parse_upload(http_body: bytes) -> object:
+    """未認証の利用者がアップロードした XML を解析して返す。"""
+    parser = etree.XMLParser(
+        resolve_entities=True, load_dtd=True, no_network=False
+    )
+    return etree.fromstring(http_body, parser)
+
+
+def parse_attachment(http_body: bytes) -> object:
+    """未認証の利用者がアップロードした XML を解析して返す。"""
+    parser = etree.XMLParser(
+        resolve_entities=True, load_dtd=True, no_network=False
+    )
+    return etree.fromstring(http_body, parser)
